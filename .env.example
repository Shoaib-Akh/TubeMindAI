# Next.js App
NEXT_PUBLIC_SITE_URL=https://tubemind.ai

# Supabase (PostgreSQL & Auth)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# YouTube Proxy (Recommended for Vercel / Cloud serverless deployments to bypass YouTube IP blocks)
# Example: http://username:password@proxy_ip:port from Webshare.io or BrightData
YOUTUBE_PROXY=

# RapidAPI YouTube Transcript Key (Optional third-party fallback)
RAPIDAPI_KEY=

# Speech-to-Text Fallback (Groq Whisper AI)
GROQ_API_KEY=gsk_...
STT_API_KEY=gsk_...

# AI Providers (Optional - App includes heuristic fallback if unconfigured)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=...
ANTHROPIC_API_KEY=...
